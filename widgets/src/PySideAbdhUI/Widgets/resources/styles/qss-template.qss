/* Managed: this templete is a bundle with color-palettes.json */

*{
    font-size: 10pt;
    font-family: "Vazirmatn FD";
}
QWidget[class="window-background-layer"] 
{
    background-color: --base-background--;
    color: --text-secondary--;
    border: 1px solid --border--;
    border-radius: 8px;
    padding: 25px;
}
QWidget[class="window-background-layer-maximized"] 
{
    background-color: --base-background--;
    color: --text-secondary--;
    border: 1px solid --border--;
    border-radius: 0px;
    padding: 25px;
}

/* background layer of panels and surfaces*/
QWidget[class="surface-background-layer"] 
{
    background-color: --surface--;
    color: --text-secondary--;
    border: 1px solid --border--;
    border-radius: 8px;
}

/* background layer of cards in the panels */
QWidget[class="card"] 
{
    background-color: --surface-variant--;
    border: 2px solid --border--;
    border-radius: 8px;
    padding: 5px;
}

/* background layer of cards when selected */
QWidget[class="card-selected"] 
{
    background-color: --accent--;
    border:2px solid --accent-light--;
}

QWidget[class="image-box"] 
{
    background-color:rgba(100, 150, 255, 25); 
    border: 2px dashed --accent--;
    color:--text-disabled--; 
    border-radius: 4px; 
    padding:1px;
    font-size: 24pt;
    font-weight: bold;
}

/* background layer of Sidebar panels */
QFrame[class="left-sidebar-background-layer"] 
{
    background-color: --surface--;
    color: --text-secondary--;
    border: none;
    border-top-left-radius: 8px;
    border-bottom-left-radius: 8px;
    border-top-right-radius: 0px;
    border-bottom-right-radius: 0px;
    padding: 0px;
}
/* background layer of Sidebar panels */
QFrame[class="right-sidebar-background-layer"]
{
    background-color: --surface--;
    color: --text-secondary--;
    border: none;
    border-top-left-radius: 0px;
    border-bottom-left-radius: 0px;
    border-top-right-radius: 8px;
    border-bottom-right-radius: 8px;
    padding: 0px;
}

/* Learning materials with white background in the papers */
QLabel[class="EduText"]
{
    background-color: #ffffff;
    color: #202124;
    border-top-left-radius: 0px;
    border-top-right-radius: 0px;
    border-bottom-left-radius: 6px;
    border-bottom-right-radius: 6px;
    padding: 8px;
    border:none;
    
}

QWidget[class="EduItem"]
{
    background-color: #ffffff;
    color: #202124;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-left-radius: 6px;
    border-bottom-right-radius: 6px;
    border:none;
}

QWidget[class="EduItem-Selected"]
{
    background-color: #ffffff;
    color: #202124;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-left-radius: 6px;
    border-bottom-right-radius: 6px;
    border:2px solid --accent--;
}

QWidget#Titlebar 
{
    background-color: transparent;
    color: --text-secondary--;
    border: 0px;
    border-top-left-radius: 8px;
    border-bottom-left-radius: 0px;
    border-top-right-radius: 8px;
    border-bottom-right-radius: 0px;
}


/* Popup Main Widget */
QWidget#PopupNotifier 
{
    background-color: --surface-variant--;
    border: 1px solid --accent--;
    border-radius: 8px;
    padding: 0px;
}

/* Popup Title Area */
QWidget#PopupTitle 
{
    background-color: --accent--; 
    color: --accent-contrast--; 
    border-top: 1px solid --accent-light--;
    border-left: 1px solid --accent-light--;
    border-right: 1px solid --accent-light--;
    border-bottom:none;
    font-weight: bold;
    padding: 6px 10px;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius:0px;
    border-bottom-right-radius:0px;
}

/* Popup Content Text (like QLabel inside)*/
QLabel#PopupText 
{
    color: --text-primary--;
    background-color: --surface--; 
    padding: 6px 10px;
    border-top: none;
    border-left: 1px solid --accent-light--;
    border-right: 1px solid --accent-light--;
    border-bottom:none;
    border-radius: 0px;
}
QDateEdit {
    background-color: #2A2A2A; /* input-background */
    color: #F1F1F1; /* text-primary */
    border: 1px solid #4A4A4A; /* input-border */
    border-radius: 4px;
    padding: 4px 8px;
    selection-background-color: #0c4ce0; /* accent */
    selection-color: #FFFFFF; /* accent-contrast */
}

QDateEdit:hover {
    background-color: #2E2E2E; /* hover */
    border: 1px solid #156fff; /* accent-light */
}

QDateEdit:focus {
    border: 1px solid #0c4ce0; /* accent */
}

QDateEdit:disabled {
    background-color: #2B2B2B; /* input-disabled-background */
    color: #777777; /* input-disabled-text */
    border: 1px solid #2F2F2F; /* disabled-border */
}

QDateEdit::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 20px;
    border-left: 1px solid #4A4A4A; /* input-border */
    background-color: #2A2A2A; /* input-background */
}

QDateEdit::down-arrow {
    image: url(:icons/chevron-down.svg);
    width: 12px;
    height: 12px;
}

QCalendarWidget {
    background-color: #1C1C1C; /* surface */
    color: #F1F1F1; /* text-primary */
    border: 1px solid #3A3A3A; /* border */
    selection-background-color: #0c4ce0; /* accent */
    selection-color: #FFFFFF; /* accent-contrast */
}

QCalendarWidget QWidget#qt_calendar_navigationbar { 
    background-color: #2C2C2C; /* button-background */
}

QCalendarWidget QToolButton {
    background-color: #2C2C2C; /* button-background */
    color: #F1F1F1; /* button-text */
    border: none;
    padding: 5px;
}

QCalendarWidget QToolButton:hover {
    background-color: #383838; /* button-hover */
}

QCalendarWidget QToolButton:pressed {
    background-color: #4A4A4A; /* button-pressed */
}

QCalendarWidget QToolButton:disabled {
    background-color: #2B2B2B; /* button-disabled */
    color: #777777; /* button-disabled-text */
}


QPushButton#PopupActionButton 
{
    background: --button-background--;
    color: --button-text--;
    border-top: none;
    border-left: 1px solid --accent-light--;
    border-right: none;
    border-bottom:1px solid --accent-light--;
    border-top-left-radius: 0px;
    border-top-right-radius: 0px;
    border-bottom-left-radius:8px;
    border-bottom-right-radius:0px;
}
/* Optional: Close Button inside Popup */
QPushButton#PopupCloseButton 
{
    background: --button-background--;
    color: --button-text--;
    border-top: none;
    border-left: none;
    border-right: 1px solid --accent-light--;
    border-bottom:1px  solid --accent-light--;
    border-top-left-radius: 0px;
    border-top-right-radius: 0px;
    border-bottom-left-radius:0px;
    border-bottom-right-radius:8px;
}
QPushButton#PopupActionButton:hover 
{
    background-color: --button-hover--;
    color: --accent-contrast--;
}
QPushButton#PopupCloseButton:hover 
{
    background-color: #dc3545;
    color: --accent-contrast--;
}

/* ------------------------------------------------------------- */

QStackedWidget.stack
{
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
}
QWidget 
{
    background-color: transparent;
    color: --text-secondary--;
    border: none;
    border-radius: 4px;
}
QFrame
{
    background-color: --base-background--;
    border: none;
    border-radius: 0px;
    padding: 0px; 
    color: --text-secondary--;
}
QToolTip 
{
    background-color: --surface--;
    color: --info--;
    border: 1px solid --accent--;
    padding: 5px;
    border-radius: 4px;
}

QScrollArea {
    background-color: transparent;
    border: none;
}
QScrollBar:Corner {
    background-color: --surface-variant--;
    border-radius: 4px;
}

/* Track */
QScrollBar:vertical {
    background-color: transparent;
    border: none;
    border-radius: 2px;
    width: 4px;
}
QScrollBar:horizontal {
    background-color: transparent;
    border: none;
    border-radius: 2px;
    height: 4px;
}

/* Tiny handle using transparent borders (thickness = track - border) */
QScrollBar::handle:vertical {
    background-color: --accent--;
    border: none;
    border-left:  2px solid transparent;   /* shrinks visible width to 2px */
    border-right: 2px solid transparent;
    border-radius: 2px;
}
QScrollBar::handle:horizontal {
    background-color: --accent--;
    border: none;
    border-top:    2px solid transparent;   /* shrinks visible height to 2px */
    border-bottom: 2px solid transparent;
    border-radius: 2px;
}

/* On hover: remove the transparent border → handle expands to full size */
QScrollBar::handle:vertical:hover {
    background-color: --accent--;
    border: none;                /* no side borders → full 4px width */
}
QScrollBar::handle:horizontal:hover {
    background-color: --accent--;
    border: none;                /* full 4px height */
}

/* Remove arrow buttons */
QScrollBar::add-line, QScrollBar::sub-line {
    background: none;
    border: none;
    height: 0px;
    width: 0px;
}
QScrollBar::add-page, QScrollBar::sub-page 
{
    background: none;
}

/* ----------------- TEXT STYLES ----------------- */

/* General Label Defaults */
QLabel 
{
    border-radius: 4px;
    border: none;
    background-color: transparent;
    color: --text-secondary--;
    padding: 4px 8px;
}
QLabel:focus
{
    color:red;
}
/* Headings */
QLabel[class="heading1"] {
    color: --text-primary--;
    font-size: 24pt;
    font-weight: bold;
}

QLabel[class="heading2"] 
{
    color: --text-primary--;
    font-size: 20pt;
    font-weight: bold;
}

QLabel[class="heading3"] {
    color: --text-primary--;
    font-size: 16pt;
    font-weight: bold;
}
/* Title */
QLabel[class="title"] {
    color: --text-primary--;
    font-size: 18pt;
    font-weight: 600;
    letter-spacing: 0.5px;
}

/* Subtitle */
QLabel[class="subtitle"] {
    color: --text-secondary--;
    font-size: 14pt;
    font-weight: 600;
    padding:0px;
    qproperty-alignment: AlignCenter;
}

/* Caption */
QLabel[class="caption"] 
{
    color: --text-disabled--;
    font-size: 10pt;
}

/* Hyperlink */
QLabel[class="hyperlink"] 
{
    color: --accent-dark--;
    text-decoration: underline;
}

QLabel[class="hyperlink"]:hover {
    color: --accent-light--;
}

/* Inverse text (for light surfaces) */
QLabel[class="inverse"] {
    color: --text-inverse--;
}

/* Monospace (code-like) */
QLabel[class="code"] {
    font-family: Consolas, "Courier New", monospace;
    font-size: 11pt;
    color: --text-primary--;
}

/* Emphasis */
QLabel[class="emphasis"] {
    font-style: italic;
    color: --text-primary--;
}

/* Strong emphasis */
QLabel[class="strong"] 
{
    font-weight: bold;
    color: --text-primary--;
}

/* Table Header QLabel – apply via objectName or class */
QLabel[class="table-header"]
{
    background-color: --surface-variant--;
    color: --text-primary--;
    font-weight: bold;
    padding: 6px 10px;
    border-bottom: 2px solid --border--;
    border-right: 1px solid --border--;
    min-height: 20px;
    border-radius:0px;
    qproperty-alignment: AlignCenter;
}

QLabel[class="table-header"]:hover {
    background-color: --hover--;
}

QLabel[class="table-header"]:disabled {
    color: --text-disabled--;
    background-color: --surface--;
}

/*------------------- data and lists ----------- */
/* All headers */
QHeaderView::section 
{
    background-color: --base-background--;
    color: --text-primary--;
    padding: 5px;
    border-top: 1px solid --border--;
    font-weight: bold;
    padding-right:-8px;
}

/* First header section (left-most) */
QHeaderView::section:first 
{
    border-top-left-radius: 4px;
    border-left: 1px solid --border--;
    border-top: 1px solid --border--;
}

/* Last header section (right-most) */
QHeaderView::section:last 
{
    border-top-right-radius: 4px;
    border-right: 1px solid --border--;
    border-top: 1px solid --border--;
}


QTableCornerButton::section 
{
    background-color: --surface-variant--;
    border: 1px solid --border--;
}


QMessageBox 
{
    background-color: --surface-variant--;
    border: 1px solid --border--;
    border-radius: 8px;
}
/* ----------------- EDIT ----------------- */
QLineEdit, QTextEdit, QSpinBox,
QPlainTextEdit, QComboBox, 
QDateTimeEdit, QTimeEdit, QDateEdit
{
    background-color: --input-background--;
    color: --text-primary--;
    border: 1px solid --input-border--;
    padding-top:2px;
    padding-bottom:2px;
    padding-left:5px;
    padding-right:5px;
    border-radius: 4px;
    min-height:28px;
}
QSpinBox
{
    background-color: --input-background--;
    color: --text-primary--;
    border: 1px solid --input-border--;
    padding-top:0px;
    padding-bottom:0px;
    padding-left:2px;
    padding-right:2px;
    border-radius: 4px;
    min-height:28px;
}
QPushButton 
{
    background-color: --button-background--;
    color: --button-text--;
    border: 1px solid --button-border--;
    padding-top: 2px;
    padding-bottom:2px;
    padding-left:15px;
    padding-right:15px;
    border-radius: 4px;
    min-height:28px;
}
QLineEdit:focus, QTextEdit:focus, 
QPlainTextEdit:focus,
QDateTimeEdit:focus, 
QDateEdit:focus, QTimeEdit:focus
{
    border: 1px solid --accent--;
}

QLineEdit:disabled, 
QTextEdit:disabled, 
QPlainTextEdit:disabled, 
QDateTimeEdit:disabled, 
QTimeEdit:disabled
{
    background-color: --input-disabled-background--;
    border: 1px solid --input-disabled-border--;
    color: --input-disabled-text--;
}

QLineEdit:hover, QTextEdit:hover, 
QPlainTextEdit:hover,
QDateTimeEdit:hover, QTimeEdit:hover
{
    border: 1px solid --accent-light--;
}
QComboBox::open
{
    border: 1px solid --accent--;
}
QComboBox::drop-down 
{
    border: none;
    width: 20px;
}
QComboBox::drop-down:hover 
{
    background:--accent-dark--;
    border-top-right-radius:4px;
    border-bottom-right-radius:4px;
}

QComboBox::down-arrow 
{
    width: 12px;
    height: 12px;
    padding:0px;
    image:url(:icons/chevron-down.svg);
}

QComboBox QAbstractItemView 
{
    background-color: --input-background--;
    color: --text-primary--;
    selection-background-color: --accent--;
    border: 1px solid --accent--;
    border-radius: 4px;
}
/*ubuntu background "#FF5722"*/
/* ----------------- BUTTONS ----------------- */


QPushButton[class="MenuItem"] 
{
    background-color: transparent;
    color: --button-text--;
    border: none;
    padding: 5px 10px;
    text-align: left;
    font-size:12pt;
}

QPushButton[class="MenuItem"]:checked 
{
    background-color: --button-background--;
    border-left:6px solid --accent--;
    border-radius:0px;
}
QPushButton[class="MenuItem"]:disabled 
{
    background-color: --button-disabled--;
    color:--button-disabled-text--;
    border: none;
    border-radius:0px;
}
QPushButton[class="mini"] 
{
    background-color: transparent;
    color: --button-text--;
    border: none;
    padding: 2px;
    border-radius: 4px;
    width: 32px;
    min-width:32px;
    max-width:32px;
    height: 32px;
    min-height:32px;
    max-height:32px;
}
QPushButton.checkLike
{
    background-color: transparent;
    color: --button-text--;
    border: 2px solid --accent--;
    padding: 0px;
    border-radius: 4px;
    width: 16px;
    min-width:16px;
    max-width: 16px;
    height: 16px;
    min-height:16px;
    max-height:16px;
}

QPushButton.mini::menu-indicator
{  
    width: 0px;
    min-width:0px;
    max-width: 0px;
    height: 0px;
    min-height:0px;
    max-height:0px;
}

QPushButton[class="close-button"] 
{
    font-size:14pt;
    background-color: transparent;
    color: --button-text--;
    padding: 5px;
    border-top-left-radius: 0px;
    border-bottom-right-radius: 0px;
    border-top-right-radius: 8px;     /* To sync by top-right border of the main window*/
    border-bottom-left-radius: 0px;
    border-width: 0px;
    width: 32px;
    min-width:32px;
    max-width: 24px;
    height: 24px;
    min-height:24px;
    max-height:24px;
}
QPushButton[class="close-button-maximized"] 
{
    font-size:14pt;
    background-color: transparent;
    color: --button-text--;
    padding: 5px;
    border-radius: 0px;
    border-width: 0px;
    width: 32px;
    min-width:32px;
    max-width: 24px;
    height: 24px;
    min-height:24px;
    max-height:24px;
}
QPushButton:pressed,
QPushButton.mini:pressed,
QPushButton.MenuItem:pressed
{
    background-color: --button-pressed--;
}

QPushButton:disabled,
QPushButton.mini:disabled
{
    background-color: --button-disabled--;
    border: 1px solid --disabled-border--;
    color: --button-disabled-text--;
}
QPushButton[class="close-button"]:hover
{
    background-color: #c80a0a;
    border:none;
    border-top-left-radius: 0px;
    border-bottom-right-radius: 0px;
    border-top-right-radius: 8px;     /* To sync by top-right border of the main window*/
    border-bottom-left-radius: 0px;
}
QPushButton[class="close-button-maximized"]:hover
{
    background-color: #c80a0a;
    border:none;
    border-radius: 0px;
}
QPushButton[class="mini"]:hover
{
    background-color: --button-hover--;
    border:noone;
    font-size:10pt;
    border-radius:4px;
}
QPushButton.MenuItem:hover
{
    background-color: --button-hover--;
    padding: 5px 10px;
    font-size:10pt;
    border-radius:0px;
    border-left:6px solid --accent-light--;
}
QPushButton:hover,
QPushButton.checkLike
{
    background-color: --button-hover--;
    border:none;
    padding: 5px 10px;
    font-size:10pt;
    border-radius:4px;
}

QPushButton::menu-indicator 
{  
    subcontrol-origin: padding;
    subcontrol-position: right center;
    right: 0px;
    width: 0px;
    height: 0px;
}
QPushButton::menu-indicator:open 
{
    background-color: --button-text--;
}
QPushButton::menu-indicator:closed 
{
    background-color: --button-background--;
}
QPushButton::down-arrow 
{
    image: url(:icons/chevron-down.svg);
    width: 12px;
    height: 12px;
}
QPushButton::down-arrow:on 
{
    top: 1px;
}
QCheckBox, QRadioButton 
{
    background-color:transparent;
    color: --button-text--;
    border:none;
}

QCheckBox::indicator,
QRadioButton::indicator 
{
    width: 16px;
    height: 16px;
    border: 1px solid --button-border--;
    border-radius: 4px;
    padding:1px;
}

QCheckBox::indicator:checked,
QRadioButton::indicator:checked 
{
    background-color: transparent;
    image: url(:icons/check.svg);
}
QCheckBox:hover
{
    border: none;
}
QCheckBox::indicator:hover,
QRadioButton::indicator:hover 
{
    border: 1px solid --button-hover--;
}

QSlider::groove:horizontal, QSlider::groove:vertical 
{
    background-color: --surface-variant--;
    border-radius: 4px;
}

QSlider::handle:horizontal, QSlider::handle:vertical 
{
    background-color: --accent--;
    border-radius: 4px;
}

QSlider::handle:horizontal:hover, QSlider::handle:vertical:hover 
{
    background-color: --accent-light--;
}

QSlider::handle:horizontal:pressed, QSlider::handle:vertical:pressed
{
    background-color: --button-pressed--;
}

/* Progress Bar */
QProgressBar 
{
        background-color: --surface-variant--;
        border: none;
        border-radius: 3px;
        height: 3px;
        max-height:3px;
        min-height:0px;
        padding: 0px;
        text-align:top-center;
        min-width:20px;
        
}

QProgressBar::chunk 
{
    background-color: --accent--;
    border-radius: 3px;
    margin: 0px 0px 0px 0px;
}


 /* ---------------------------  MENU ---------------------------- */

QMenu 
{
    background-color: --base-background--;
    color: --text-primary--;
    border: 1px solid --accent--;
    border-radius:4px;
    padding:0px;
}

QMenu::icon 
{
    padding-left: 8px;         /* This adds margin to the icon itself */
    padding-right: 8px;        /* Adds space between icon and text */
}
QMenu::item 
{
    padding-left: 16px;        /* Total left padding: space for icon + extra margin */
    padding-right:16px;
    padding-top:8px;
    padding-bottom:8px;

}
QMenu::item:selected 
{
    background-color: --accent-light--;
    color: --accent-contrast--;
    border-left: 3px solid --accent--;
    border-right: 3px solid --accent--;
}

QMenu::separator 
{
    height: 1px;
    background: --border--;
    margin: 5px 0;
}

QMenu::item:disabled 
{
    color: --text-disabled--;
}


/* Horizontal Groove */
QSlider::groove:horizontal 
{
    border: 1px solid --border--;
    height: 4px;
    background: --surface-variant--;
    margin: 0 8px;
    border-radius: 2px;
}

QSlider::groove:vertical 
{
    border: 1px solid --border--;
    width: 4px;
    background: --surface-variant--;
    margin: 8px 0;
    border-radius: 2px;
}

/* Horizontal Handle */
QSlider::handle:horizontal 
{
    background: --accent--;
    border: 1px solid --accent--;
    width: 16px;
    height: 16px;
    margin: -6px 0px;
    border-radius: 8px;
}

QSlider::handle:vertical
{
    background: --accent--;
    border: 1px solid --accent--;
    width: 16px;
    height: 16px;
    margin: 0px -6px;
    border-radius: 8px;
}

/* Hover Effects */
QSlider::handle:hover 
{
    background: --accent-light--;
    border: 1px solid --accent--;
}

/* Horizontal Sub-page (filled part) */
QSlider::sub-page:horizontal 
{
    background: --accent--;
    border-radius: 3px;
}

QSlider::sub-page:vertical 
{
    background: --surface--;
    border-radius: 3px;
}
/* Horizontal Add-page (unfilled part) */
QSlider::add-page:horizontal 
{
    background: --surface--;
    border-radius: 3px;
}

QSlider::add-page:vertical 
{
    background: --accent--;
    border-radius: 3px;
}

/*-------------------------------------------
  Tab bar background – keep it clean
-------------------------------------------*/
QTabBar 
{
    background: transparent;
}

/*-------------------------------------------
  Individual tab buttons
-------------------------------------------*/
QTabBar::tab 
{
    background-color: transparent;
    color: --text-secondary--;
    border: 0px;
    padding: 8px 16px;
    margin-right: 2px;                         /* small gap between tabs */
}
QTabBar::tab:first {
    margin-left: 10px;   /* change to any value you like */
    background-color: transparent;
}
/*-------------------------------------------
  Selected tab – merge with pane
-------------------------------------------*/
QTabBar::tab:selected {
    background-color: transparent;             /* same as pane background */
    color: --text-secondary--;
    font-weight: bold;
    border-bottom: 4px solid --accent--;     /* hides pane’s top border */
}

/*-------------------------------------------
  Hover (unselected tabs only)
-------------------------------------------*/
QTabBar::tab:!selected:hover {
    background-color: rgba(128, 128, 128, 0.1); /* subtle overlay */
    /* If you have a --hover-- variable, use that instead */
}

/*-------------------------------------------
  Disabled tab
-------------------------------------------*/
QTabBar::tab:disabled {
    color: gray;
    background-color: --surface--;
}

/*-------------------------------------------
  Scroller buttons (when tabs overflow)
-------------------------------------------*/
QTabBar::scroller {
    width: 20px;
}

QTabBar QToolButton {
    background-color: --surface--;
    border: 1px solid --border--;
    border-radius: 4px;
    padding: 2px;
}

/* ======================================================
   QTableView & QTableWidget
   ====================================================== */

/* ---- Base table widget ---- */
QTableWidget,
QTableView 
{
    background-color: --surface--;
    color: --text-secondary--;
    border: 1px solid --border--;
    border-radius: 6px;
    gridline-color: transparent;               
    selection-background-color: --accent--;
    alternate-background-color:--surface-variant--; 
    padding:0px 2px 0px 0px;
}

QTableWidget QHeaderView::section:last,
QTableView QHeaderView::section:last 
{
    border-top-right-radius: 4px;
    border-right: 1px solid --border--;
    border-top: 1px solid --border--;
}

QTableWidget::item,
QTableView::item 
{
    padding: 0px;
    border: none;
    border-bottom: 1px solid rgba(128, 128, 128, 0.15); 
    color: --text-secondary--;
    background-color: transparent;
}


QTableView::item:alternate 
{
    background-color: rgba(128, 128, 128, 0.04);
}

QTableWidget::item:hover,
QTableView::item:hover 
{
    background-color: rgba(128, 128, 128, 0.08);
    border-bottom: 4px solid --accent-light--;
}

QTableWidget::item:selected,
QTableView::item:selected 
{
    background-color:--accent-dark--;
    color: --text-primary--;
    border: none;
}

QTableView::item:selected:hover
{
    border-bottom: 4px solid --accent--;
}
QTableWidget::item:disabled,
QTableView::item:disabled
{
    color: --text-disabled--;
}

QTableWidget::item:focus 
{
    background-color: --input-background--;
    color: --text-primary--;
    border: 1px solid --accent--;
}
QGroupBox 
{
    border: 0px solid --border--;
    border-radius: 8px;
    margin-top: 2em;
    background: transparent;
    padding:8px;
}
QGroupBox::title 
    {
        subcontrol-origin: margin;
        subcontrol-position: top left;
        left: 20px;
        padding: 0 5px;
    }
    QGroupBox::indicator 
    {
        width: 13px;
        height: 13px;
    }
    QGroupBox::indicator:checked 
    {
        image: url(:icons/checked.svg);
    }
    QGroupBox::indicator:unchecked 
    {
        image: none;
    }

    QSpinBox::up-button 
    {
        subcontrol-origin: border;
        subcontrol-position: top right;
        width: 24px;
        border-left: 0px solid --border--;
        border-bottom: 0px solid --border--;
        border-top-right-radius: 4px;
        padding:0px;
    }
    QSpinBox::down-button 
    {
        padding:0px;
        subcontrol-origin: border;
        subcontrol-position: bottom right;
        width: 24px;
        border-bottom-right-radius: 4px;
        border-left: 0px solid --border--;
    }
    QSpinBox::down-button:hover, 
    QSpinBox::up-button:hover
    {
        background:--accent-dark--;
    }
QSpinBox::down-arrow 
    {
        image: url(:icons/chevron-down.svg);
        height: 8px;
    }
    
QSpinBox::up-arrow
{
    image:url(:icons/chevron-up.svg);
    width: 8px;
    height: 8px;
}
